# ==============================================================================
# SevaDesk Production Environment Variables Configuration Template
# ==============================================================================

# Supabase PostgreSQL Connection String for Prisma ORM
# For Supabase with Connection Pooling (Transaction / Session mode):
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Or Supabase Direct Database Connection:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Secure Random JWT Secret (Required in Production)
JWT_SECRET="YOUR_SECURE_RANDOM_JWT_SECRET_KEY"

# Public Application URL
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# Supabase Client & Server SDK (Public anonymous key can be exposed to browser)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Server-only Supabase Service Role Key (NEVER expose to browser with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Optional Integrations
# RAZORPAY_KEY_ID="rzp_live_xxxxxxxx"
# RAZORPAY_KEY_SECRET="xxxxxxxxxxxx"
# GEMINI_API_KEY="AIzaSy..."
